# ---------------------------------------------------------------
# Cori configuration secrets. Copy to .env and fill in.
# Never commit .env.
# ---------------------------------------------------------------

# --- Database ---------------------------------------------------
# oracle  = Oracle AI Database 26ai Free (docker compose)   <- target
# sqlite  = local file, dev/test fallback only (no Docker needed)
DB_BACKEND=oracle
ORACLE_DSN=localhost:1521/FREEPDB1
# Password of SYS/SYSTEM in the container. Used by docker compose and by
# scripts/migrate.py to create the two users below.
# Native install without the SYSTEM password? Leave this blank and create the
# users once as SYSDBA with cori/db/migrations/oracle/000_create_users.sql.
ORACLE_PWD=ChangeMe_Sys1
# Admin user: owns the schema, runs migrations and seeding
ORACLE_ADMIN_USER=CORI_OWNER
ORACLE_ADMIN_PASSWORD=ChangeMe_Owner1
# Agent user: read-only on historical tables, writes AGENT_* / decisions
ORACLE_AGENT_USER=CORI_AGENT
ORACLE_AGENT_PASSWORD=ChangeMe_Agent1
SQLITE_PATH=data/cori.db

# --- LLM provider -------------------------------------------------
# azure | anthropic | mock   (mock = deterministic offline parsers, no API calls)
LLM_PROVIDER=azure

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# Deployment name of a vision-capable chat model (used by default for extractors A/B + summary)
AZURE_OPENAI_DEPLOYMENT=gpt-4o
# Optional: embeddings deployment (used when config.yaml embeddings.provider = azure)
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional temperature override for chat models (leave blank for provider default)
LLM_TEMPERATURE=0

# --- Service --------------------------------------------------------
UPLOAD_DIR=uploads
LOG_LEVEL=INFO
